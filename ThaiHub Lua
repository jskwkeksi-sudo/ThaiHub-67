-- ระบบ Anti-Rubberband และ Helpers ทำงานทุกเฟรม (Heartbeat)
RunService.Heartbeat:Connect(function()
    local char = LocalPlayer.Character
    if char and char:FindFirstChild("Humanoid") and char:FindFirstChild("HumanoidRootPart") then
        local humanoid = char.Humanoid
        local rootPart = char.HumanoidRootPart

        if WalkSpeedEnabled then
            humanoid.WalkSpeed = CustomWalkSpeed
            if humanoid.MoveDirection.Magnitude > 0 then
                rootPart.Velocity = Vector3.new(humanoid.MoveDirection.X * CustomWalkSpeed, rootPart.Velocity.Y, humanoid.MoveDirection.Z * CustomWalkSpeed)
            end
        end

        if InfiniteStamina_Enabled then
            pcall(function()
                local stamina = char:FindFirstChild("Stamina") or LocalPlayer:FindFirstChild("Stamina")
                if stamina then stamina.Value = 100 end
            end)
        end

        if AutoInteract_Enabled then
            pcall(function()
                for _, obj in pairs(workspace:GetDescendants()) do
                    if obj:IsA("ProximityPrompt") then
                        if (obj.Parent.Position - rootPart.Position).Magnitude <= obj.MaxActivationDistance then
                            fireproximityprompt(obj)
                        end
                    end
                end
            end)
        end
    end
end)

-- Background Loop สแกนวัตถุและตรวจจับมอนสเตอร์
task.spawn(function()
    while task.wait(0.4) do
        -- 1. อัปเดตเลขห้องจริงปัจจุบัน
        pcall(function()
            local currentRoomNum = 0
            if ReplicatedStorage:FindFirstChild("GameData") and ReplicatedStorage.GameData:FindFirstChild("LatestRoom") then
                currentRoomNum = ReplicatedStorage.GameData.LatestRoom.Value
            elseif workspace:FindFirstChild("CurrentRooms") then
                currentRoomNum = #workspace.CurrentRooms:GetChildren()
            elseif workspace:FindFirstChild("Rooms") then
                currentRoomNum = #workspace.Rooms:GetChildren()
            end
            
            if currentRoomNum > 0 then
                DoorCounterParagraph:Set("🚪 ห้อง / ประตูจริงปัจจุบัน: " .. tostring(currentRoomNum))
            else
                DoorCounterParagraph:Set("🚪 สถานะ: กำลังตรวจสอบเลขห้อง...")
            end
        end)

        -- 2. ตรวจสอบการคงอยู่ของปีศาจ (ถ้าปีศาจหายไป ให้ยกเลิกการเตือน)
        local detectedMonstersThisLoop = {}
        
        -- 3. สแกนวัตถุในแมพ
        local scanTargets = {}
        if workspace:FindFirstChild("CurrentRooms") then table.insert(scanTargets, workspace.CurrentRooms) end
        if workspace:FindFirstChild("Rooms") then table.insert(scanTargets, workspace.Rooms) end
        if workspace:FindFirstChild("Archives") then table.insert(scanTargets, workspace.Archives) end
        if workspace:FindFirstChild("Stairwell") then table.insert(scanTargets, workspace.Stairwell) end
        if workspace:FindFirstChild("Map") then table.insert(scanTargets, workspace.Map) end
        table.insert(scanTargets, workspace)

        for _, folder in pairs(scanTargets) do
            for _, obj in pairs(folder:GetDescendants()) do
                if obj:IsA("Model") or obj:IsA("BasePart") then
                    local nameLower = obj.Name:lower()

                    -- 🔴 ตรวจจับปีศาจ
                    local isMonster = false
                    for _, kw in ipairs(entityKeywords) do
                        if nameLower:find(kw) then isMonster = true break end
                    end
                    
                    if isMonster then
                        table.insert(detectedMonstersThisLoop, obj.Name)
                        
                        if MonsterESP_Enabled then
                            applyCustomHighlight(obj, Color3.fromRGB(255, 0, 0), "Monster")
                            applyCustomBillboard(obj, obj.Name, Color3.fromRGB(255, 50, 50), "Monster")
                        end

                        -- ส่งเสียงเตือนเมื่อพบครั้งแรก
                        if AlertSystem_Enabled and not activeMonsters[obj] then
                            activeMonsters[obj] = true
                            playAlertSound()
                        end
                    end

                    -- 🔵 ประตูจริง + ดึงเลขห้องมาแสดง (กรองประตูหลอก Dupe / Fake ออก)
                    if RoomItemESP_Enabled then
                        local isRealDoor = (nameLower:find("door") or nameLower:find("key") or nameLower:find("lever") or nameLower:find("padlock") or nameLower:find("flare"))
                        local isFakeDoor = (nameLower:find("dupe") or nameLower:find("fake"))

                        if isRealDoor and not isFakeDoor then
                            local roomNumberText = "Door"
                            local p = obj.Parent
                            while p and p ~= workspace do
                                if tonumber(p.Name) then
                                    roomNumberText = "Door #" .. p.Name
                                    break
                                end
                                p = p.Parent
                            end

                            applyCustomHighlight(obj, Color3.fromRGB(0, 102, 255), "Door")
                            applyCustomBillboard(obj, roomNumberText, Color3.fromRGB(0, 102, 255), "Door")
                        end
                    end

                    -- ⚪ ของแก้ปัญหา / หนังสือ / เบรกเกอร์ (สีขาว)
                    if PuzzleItemESP_Enabled and (nameLower:find("book") or nameLower:find("paper") or nameLower:find("breaker") or nameLower:find("fuse") or nameLower:find("code") or nameLower:find("battery") or nameLower:find("valve") or nameLower:find("puzzle") or nameLower:find("storage box") or nameLower:find("briefcase")) then
                        applyCustomHighlight(obj, Color3.fromRGB(255, 255, 255), "Puzzle")
                        applyCustomBillboard(obj, obj.Name, Color3.fromRGB(255, 255, 255), "Puzzle")
                    end

                    -- 🟧 ตู้ซ่อนตัว / ล็อกเกอร์ (สีส้ม)
                    if HideoutESP_Enabled and (nameLower:find("closet") or nameLower:find("locker") or nameLower:find("wardrobe") or nameLower:find("bed") or nameLower:find("hide")) then
                        applyCustomHighlight(obj, Color3.fromRGB(255, 140, 0), "Hideout")
                        applyCustomBillboard(obj, obj.Name, Color3.fromRGB(255, 140, 0), "Hideout")
                    end

                    -- 🔵 เส้นทาง Seek (สีฟ้า)
                    if SeekPath_Enabled and (nameLower:find("seekpath") or nameLower:find("pathnode") or nameLower:find("chase")) then
                        applyCustomHighlight(obj, Color3.fromRGB(0, 255, 255), "SeekPath")
                    end
                end
            end
        end

        -- 4. ล้างค่ามอนสเตอร์ที่หายไปออกจากความจำ (ถ้าปีศาจไม่อยู่แล้ว การเตือนจะหายไปทันที)
        for entityObj, _ in pairs(activeMonsters) do
            if not entityObj or not entityObj.Parent then
                activeMonsters[entityObj] = nil
            end
        end

        -- 5. อัปเดตกล่องแจ้งเตือนปีศาจบนหน้าจอ UI
        if #detectedMonstersThisLoop > 0 then
            MonsterAlertParagraph:Set("⚠️ คำเตือน: พบปีศาจ (" .. table.concat(detectedMonstersThisLoop, ", ") .. ") กำลังอยู่ในแมพ!")
        else
            MonsterAlertParagraph:Set("✅ ปลอดภัย (ยังไม่มีปีศาจในขณะนี้)")
        end
    end
end)

