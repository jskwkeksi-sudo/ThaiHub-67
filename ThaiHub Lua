-- ฟังก์ชันใส่ Highlight แบบแยกแท็กกันซ้อนทับ
local function applyCustomHighlight(object, color, tag)
    if not object or not object.Parent then return end
    local highlightName = "Highlight_" .. tag
    if not object:FindFirstChild(highlightName) then
        for _, child in pairs(object:GetChildren()) do
            if child:IsA("Highlight") and child.Name ~= highlightName then
                child:Destroy()
            end
        end
        
        local highlight = Instance.new("Highlight")
        highlight.Name = highlightName
        highlight.FillColor = color
        highlight.OutlineColor = Color3.fromRGB(255, 255, 255)
        highlight.FillTransparency = 0.4
        highlight.OutlineTransparency = 0.1
        highlight.Adornee = object
        highlight.Parent = object
    end
end

-- ฟังก์ชันใส่ Billboard แสดงชื่อและเลขประตู
local function applyCustomBillboard(object, text, color, tag)
    if not object or not object.Parent then return end
    local boardName = "Billboard_" .. tag
    if not object:FindFirstChild(boardName) then
        local billboard = Instance.new("BillboardGui")
        billboard.Name = boardName
        billboard.Size = UDim2.new(0, 180, 0, 40)
        billboard.StudsOffset = Vector3.new(0, 3, 0)
        billboard.AlwaysOnTop = true
        
        local textLabel = Instance.new("TextLabel")
        textLabel.Name = "ESPText"
        textLabel.Size = UDim2.new(1, 0, 1, 0)
        textLabel.BackgroundTransparency = 1
        textLabel.TextColor3 = color
        textLabel.TextStrokeTransparency = 0
        textLabel.TextSize = 13
        textLabel.Font = Enum.Font.SourceSansBold
        textLabel.Text = text
        textLabel.Parent = billboard
        
        billboard.Adornee = object
        billboard.Parent = object
    end
end

